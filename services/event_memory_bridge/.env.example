# NAS ONLY. Copy to .env and protect it; never commit real credentials.
# Use an existing dedicated private directory owned by NAS_UID:NAS_GID.
EVENT_MEMORY_HOST_STORAGE=/replace-with-your-private-nas-directory
NAS_UID=1000
NAS_GID=1000
EVENT_MEMORY_BIND_IP=127.0.0.1
EVENT_MEMORY_KEY=REPLACE_WITH_SEPARATE_RANDOM_BASE64_KEY
EVENT_MEMORY_OWNER=REPLACE_WITH_CITY_MANAGER_LOGIN
EVENT_MEMORY_VAULT_NAME=REPLACE_WITH_ACTUAL_PRIVATE_VAULT_NAME
EVENT_MEMORY_APP_ORIGIN=https://replace-with-dashboard-domain.example

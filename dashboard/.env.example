# Copy to .env on the server. Never commit real secrets.
DB_PASSWORD=replace-locally

# City Manager OS display/session timezone.
# Applied to both the private dashboard and public Operations portal.
APP_TIMEZONE=America/New_York

# Existing employee portal secrets must remain local only.
STAFF_TOKEN=replace-locally
STAFF_SESSION_SECRET=replace-with-long-random-value

# Phase 2 Operations access settings.
# Leave secure cookies off until HTTPS is actually active.
STAFF_SECURE_COOKIES=false
STAFF_TRUST_PROXY=false
STAFF_PUBLIC_ORIGIN=
STAFF_ALLOWED_HOSTS=*
STAFF_BIND_IP=0.0.0.0
STAFF_LOGIN_MAX_FAILURES=8
STAFF_LOGIN_WINDOW_SECONDS=900

# Production HTTPS target example:
# STAFF_SECURE_COOKIES=true
# STAFF_TRUST_PROXY=true
# STAFF_PUBLIC_ORIGIN=https://ops.nhnj.us
# STAFF_ALLOWED_HOSTS=ops.nhnj.us,localhost,127.0.0.1
# STAFF_BIND_IP=127.0.0.1

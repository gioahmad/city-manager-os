# Copy to .env on the server. Never commit real secrets.
DB_PASSWORD=replace-locally

# City Manager OS web/application timezone.
APP_TIMEZONE=America/New_York

# Private dashboard authentication.
# bootstrap-private-auth.sh generates the secret, automation token and Executive password hash locally.
CMOS_AUTH_ENABLED=false
CMOS_AUTH_SECURE_COOKIES=false
CMOS_AUTH_TRUST_PROXY=false
CMOS_PUBLIC_ORIGIN=
CMOS_SESSION_SECRET=
CMOS_AUTOMATION_TOKEN=
CMOS_EXECUTIVE_USERNAME=gio
CMOS_EXECUTIVE_PASSWORD_HASH=
CMOS_SUPERVISOR_USERNAME=
CMOS_SUPERVISOR_PASSWORD_HASH=
CMOS_READONLY_USERNAME=
CMOS_READONLY_PASSWORD_HASH=
CMOS_LOGIN_MAX_FAILURES=8
CMOS_LOGIN_WINDOW_SECONDS=900

# Enable Secure cookies only when the private dashboard is served through HTTPS.
# CMOS_AUTH_SECURE_COOKIES=true
# CMOS_AUTH_TRUST_PROXY=true
# CMOS_PUBLIC_ORIGIN=https://private-dashboard.example

# Existing employee portal secrets must remain local only.
STAFF_TOKEN=replace-locally
STAFF_SESSION_SECRET=replace-with-long-random-value

# Phase 2 Operations access settings.
# Leave secure cookies off until HTTPS is actually active.
STAFF_SECURE_COOKIES=false
STAFF_TRUST_PROXY=false
STAFF_PUBLIC_ORIGIN=
STAFF_ALLOWED_HOSTS=*
STAFF_BIND_IP=0.0.0.0
STAFF_LOGIN_MAX_FAILURES=8
STAFF_LOGIN_WINDOW_SECONDS=900

# Phase 3 recurring/daily Operations Engine.
OPS_ENGINE_INTERVAL_SECONDS=60

# Production HTTPS target example:
# STAFF_SECURE_COOKIES=true
# STAFF_TRUST_PROXY=true
# STAFF_PUBLIC_ORIGIN=https://ops.nhnj.us
# STAFF_ALLOWED_HOSTS=ops.nhnj.us,localhost,127.0.0.1
# STAFF_BIND_IP=127.0.0.1

# Regional Transit Intelligence (NJ TRANSIT Phase 1)
# Leave credential values blank in the repository example. Real values stay in server .env only.
NJT_USERNAME=
NJT_PASSWORD=
# Official production rail host. Override with the NJ TRANSIT test host during validation if needed.
NJT_RAIL_HOST=https://raildata.njtransit.com
# Current NJ TRANSIT bus API host and stable static GTFS prefix.
NJT_BUS_HOST=https://pcsdata.njtransit.com
NJT_BUS_GTFS_PREFIX=/api/GTFS
# BUSDV2 getVehicleLocations radius is measured in feet.
NJT_BUS_RADIUS_FEET=30000
# Reusable NJT rail tokens are cached locally, never committed or stored in database configuration.
TRANSIT_TOKEN_CACHE_DIR=/app/transit_tokens
# Hudson / Manhattan regional live-vehicle capture window: west,south,east,north.
TRANSIT_CAPTURE_BBOX=-74.10,40.68,-73.90,40.85

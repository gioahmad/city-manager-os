# Copy this file to .env on the VPS and replace the password.
# NEVER commit the real .env file.

POSTGRES_DB=citymanager
POSTGRES_USER=citymanager_app
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Backup policy.
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=36
BACKUP_REQUIRE_OFFBOX=false

# Configure ONE off-box destination when available.
# Option A: mounted remote/NAS/cloud filesystem path.
BACKUP_OFFBOX_DIR=

# Option B: rsync-over-SSH target, for example:
# backupuser@100.x.y.z:/srv/backups/city-manager-os
BACKUP_OFFBOX_TARGET=

#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ROOT="/opt/city-manager-os"
ENV_FILE="$ROOT/dashboard/.env"
UPSTREAM="${CMOS_DASH_URL:-http://100.94.203.47:8090}"
TMP="$(mktemp -d /tmp/cmos-e2e-secure.XXXXXX)"
PORT_FILE="$TMP/port"
PROXY_LOG="$TMP/proxy.log"
PATCHED_E2E="$TMP/cmos-e2e-acceptance"
PROXY_PID=""

cleanup(){
  set +e
  if [[ -n "$PROXY_PID" ]]; then
    kill "$PROXY_PID" >/dev/null 2>&1 || true
    wait "$PROXY_PID" >/dev/null 2>&1 || true
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT

[[ -f "$ENV_FILE" ]] || {
  echo "ERROR: dashboard .env not found"
  exit 1
}

TOKEN="$(python3 - "$ENV_FILE" <<'PY'
from pathlib import Path
import sys
for line in Path(sys.argv[1]).read_text().splitlines():
    if line.startswith('CMOS_AUTOMATION_TOKEN='):
        print(line.split('=',1)[1].strip())
        break
PY
)"

if [[ -z "$TOKEN" ]]; then
  if [[ -n "${CMOS_E2E_EXPECTED_HEAD:-}" ]]; then
    echo "ERROR: candidate E2E requires CMOS_AUTOMATION_TOKEN"
    exit 1
  fi
  exec "$ROOT/deploy/cmos-e2e-acceptance"
fi

python3 - "$UPSTREAM" "$TOKEN" "$PORT_FILE" >"$PROXY_LOG" 2>&1 <<'PY' &
from __future__ import annotations

import http.client
import http.server
import ssl
import sys
from pathlib import Path
from urllib.parse import urlsplit

upstream = urlsplit(sys.argv[1])
token = sys.argv[2]
port_file = Path(sys.argv[3])

if upstream.scheme not in {"http", "https"} or not upstream.hostname:
    raise SystemExit("Invalid CMOS_DASH_URL")

base_path = upstream.path.rstrip("/")
upstream_port = upstream.port or (443 if upstream.scheme == "https" else 80)


class Proxy(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        return

    def _handle(self):
        length = int(self.headers.get("content-length", "0") or 0)
        body = self.rfile.read(length) if length else None

        headers = {}
        for key, value in self.headers.items():
            if key.lower() in {
                "host",
                "connection",
                "proxy-connection",
                "content-length",
            }:
                continue
            headers[key] = value
        headers["X-CMOS-Automation-Key"] = token
        if body is not None:
            headers["Content-Length"] = str(len(body))

        connection_cls = (
            http.client.HTTPSConnection
            if upstream.scheme == "https"
            else http.client.HTTPConnection
        )
        kwargs = {"timeout": 60}
        if upstream.scheme == "https":
            kwargs["context"] = ssl.create_default_context()

        conn = connection_cls(upstream.hostname, upstream_port, **kwargs)
        target = base_path + self.path
        conn.request(self.command, target, body=body, headers=headers)
        response = conn.getresponse()
        payload = response.read()

        self.send_response(response.status, response.reason)
        for key, value in response.getheaders():
            if key.lower() in {
                "connection",
                "transfer-encoding",
                "content-length",
            }:
                continue
            self.send_header(key, value)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(payload)
        conn.close()

    do_GET = _handle
    do_HEAD = _handle
    do_POST = _handle
    do_PUT = _handle
    do_PATCH = _handle
    do_DELETE = _handle


server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Proxy)
port_file.write_text(str(server.server_address[1]))
server.serve_forever()
PY
PROXY_PID=$!

for _ in $(seq 1 50); do
  [[ -s "$PORT_FILE" ]] && break
  if ! kill -0 "$PROXY_PID" >/dev/null 2>&1; then
    cat "$PROXY_LOG" >&2 || true
    echo "ERROR: secure E2E proxy failed to start"
    exit 1
  fi
  sleep 0.1
done

[[ -s "$PORT_FILE" ]] || {
  cat "$PROXY_LOG" >&2 || true
  echo "ERROR: secure E2E proxy did not publish a port"
  exit 1
}

# The base E2E harness has one Mapping Center check that deliberately executes
# from inside the dashboard container against 127.0.0.1:8000. Once private
# dashboard authentication is enabled that internal request also needs the
# automation credential. Patch only a temporary copy so the base harness stays
# provider/auth neutral and the repository remains clean during acceptance.
python3 - "$ROOT/deploy/cmos-e2e-acceptance" "$PATCHED_E2E" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text()
target = Path(sys.argv[2])

old_command = (
    'docker exec -i citymanager-dashboard python - '
    '"$SAMPLE_LAT" "$SAMPLE_LON" <<\'PY\''
)
new_command = (
    'docker exec -e CMOS_E2E_AUTOMATION_TOKEN -i '
    'citymanager-dashboard python - '
    '"$SAMPLE_LAT" "$SAMPLE_LON" <<\'PY\''
)

old_import = 'import json,sys,urllib.parse,urllib.request\n'
new_import = '''import json,os,sys,urllib.parse,urllib.request\n_token=os.environ.get("CMOS_E2E_AUTOMATION_TOKEN","").strip()\nassert _token, "CMOS_E2E_AUTOMATION_TOKEN missing"\n_opener=urllib.request.build_opener()\n_opener.addheaders=[("X-CMOS-Automation-Key",_token)]\nurllib.request.urlopen=_opener.open\n'''

old_repo_gate = """git fetch -q origin main || fail "Could not fetch origin/main"
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || fail "Local main does not match origin/main"
pass "Repository is clean and matches origin/main"
"""

new_repo_gate = """git fetch -q origin main || fail "Could not fetch origin/main"
if [[ -n "${CMOS_E2E_EXPECTED_HEAD:-}" ]]; then
  [[ "$(git rev-parse HEAD)" == "$CMOS_E2E_EXPECTED_HEAD" ]] \\
    || fail "Local HEAD does not match the expected deployment candidate"
  git merge-base --is-ancestor origin/main "$CMOS_E2E_EXPECTED_HEAD" \\
    || fail "Deployment candidate is not based on origin/main"
  pass "Repository is clean and candidate commit is based on origin/main"
else
  [[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] \\
    || fail "Local main does not match origin/main"
  pass "Repository is clean and matches origin/main"
fi
"""

if source.count(old_command) != 1:
    raise SystemExit('Expected one internal Mapping Center docker exec block')
if source.count(old_import) < 1:
    raise SystemExit('Expected Mapping Center urllib import not found')

source = source.replace(old_command, new_command, 1)
# Replace the urllib import nearest the Mapping Center block, not unrelated code.
marker = new_command
head, tail = source.split(marker, 1)
if old_import not in tail:
    raise SystemExit('Mapping Center urllib import not found after docker exec block')
tail = tail.replace(old_import, new_import, 1)
source = head + marker + tail

if source.count(old_repo_gate) != 1:
    raise SystemExit("Expected one base E2E repository gate")
source = source.replace(old_repo_gate, new_repo_gate, 1)

target.write_text(source)
target.chmod(0o700)
PY

PORT="$(cat "$PORT_FILE")"
export CMOS_E2E_AUTOMATION_TOKEN="$TOKEN"
CMOS_DASH_URL="http://127.0.0.1:$PORT" \
  "$PATCHED_E2E"

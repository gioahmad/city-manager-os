"""

PROFILES = {
    "earthquake": {
        "workflow_id": "6BEPAwdUkOKFEppQ",
        "branch": "Check If Should Send",
        "existing": "Push Quake Alert to NTFY",
        "label": "Earthquake",
        "build": "Build Standard Earthquake Alert",
        "js": EARTHQUAKE_JS,
    },
    "oru": {
        "workflow_id": "lgjND0RSgJf823gL",
        "branch": "Should Send?",
        "existing": "Publish NTFY",
        "label": "ORU",
        "build": "Build Standard ORU Alert",
        "js": ORU_JS,
    },
    "bnn": {
        "workflow_id": "91kogN5QvQ7s8AkR",
        "branch": "Webhook",
        "existing": "Push to ntfy",
        "label": "BNN",
        "build": "Build Standard BNN Alert",
        "js": BNN_JS,
    },
}

unknown = [x for x in requested if x not in PROFILES]
if unknown:
    raise SystemExit("Unknown source(s): " + ", ".join(unknown))

con = sqlite3.connect(db)
con.row_factory = sqlite3.Row
cur = con.cursor()

# Safe SQLite backup.
stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
backup = f"{db}.before_cmos_sources_{stamp}"
dst = sqlite3.connect(backup)
con.backup(dst)
dst.close()

print("BACKUP:", backup)

template = cur.execute(
    "SELECT * FROM workflow_entity WHERE id=?",
    (NHRFR_ID,)
).fetchone()

if not template:
    raise SystemExit("Proven NHRFR template workflow not found.")

template_nodes = {
    n["name"]: n
    for n in json.loads(template["nodes"])
}

def table_exists(name):
    return cur.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
        (name,)
    ).fetchone() is not None

def columns(name):
    return [dict(r) for r in cur.execute(f'PRAGMA table_info("{name}")')]

def clone_history(workflow_id, old_version, new_version, nodes_json, connections_json, now):
    if not table_exists("workflow_history"):
        return False

    cols = columns("workflow_history")
    names = [c["name"] for c in cols]

    wf_col = next((x for x in ("workflowId","workflow_id") if x in names), None)
    ver_col = next((x for x in ("versionId","version_id") if x in names), None)

    if not wf_col or not ver_col:
        return False

    row = cur.execute(
        f'SELECT * FROM workflow_history WHERE "{wf_col}"=? AND "{ver_col}"=? LIMIT 1',
        (workflow_id, old_version)
    ).fetchone()

    if not row:
        return False

    data = dict(row)
    data[ver_col] = new_version

    if "nodes" in data:
        data["nodes"] = nodes_json

    if "connections" in data:
        data["connections"] = connections_json

    for field in ("createdAt","created_at","updatedAt","updated_at"):
        if field in data:
            data[field] = now

    insert_cols = []
    insert_vals = []

    for c in cols:
        name = c["name"]

        if c["pk"] and name != ver_col and "INT" in (c["type"] or "").upper():
            continue

        insert_cols.append(name)
        insert_vals.append(data.get(name))

    qcols = ",".join(f'"{x}"' for x in insert_cols)
    marks = ",".join("?" for _ in insert_cols)

    cur.execute(
        f'INSERT INTO workflow_history ({qcols}) VALUES ({marks})',
        insert_vals
    )

    return True

def patch_source(key, cfg):
    row = cur.execute(
        "SELECT * FROM workflow_entity WHERE id=?",
        (cfg["workflow_id"],)
    ).fetchone()

    if not row:
        raise RuntimeError(f"{key}: workflow not found")

    nodes = json.loads(row["nodes"])
    connections = json.loads(row["connections"])

    names = {n.get("name") for n in nodes}

    if cfg["build"] in names:
        print(f"{key.upper()}: already centralized — skipped")
        return False

    node_map = {n["name"]: n for n in nodes}

    if cfg["branch"] not in node_map:
        raise RuntimeError(f"{key}: branch node '{cfg['branch']}' not found")

    branch_conn = connections.get(cfg["branch"], {}).get("main", [])

    if not branch_conn or not branch_conn[0]:
        raise RuntimeError(f"{key}: branch has no output")

    if not any(
        x.get("node") == cfg["existing"]
        for x in branch_conn[0]
    ):
        raise RuntimeError(
            f"{key}: existing direct ntfy path '{cfg['existing']}' not found"
        )

    label = cfg["label"]

    upsert = copy.deepcopy(
        template_nodes["Upsert Alert to City Manager OS"]
    )
    restore = copy.deepcopy(
        template_nodes["Restore Standard NHRFR Alert"]
    )
    matcher = copy.deepcopy(
        template_nodes["Send to Central Watchlist Matcher"]
    )

    build_name = cfg["build"]
    upsert_name = f"Upsert {label} Alert to City Manager OS"
    restore_name = f"Restore Standard {label} Alert"
    matcher_name = f"Send {label} to Central Watchlist Matcher"

    bx, by = node_map[cfg["branch"]].get("position", [0, 0])
    cy = by + 240

    build = {
        "parameters": {"jsCode": cfg["js"]},
        "name": build_name,
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [bx + 224, cy],
        "id": f"cmos-{key}-build"
    }

    upsert["id"] = f"cmos-{key}-upsert"
    upsert["name"] = upsert_name
    upsert["position"] = [bx + 480, cy]

    restore["id"] = f"cmos-{key}-restore"
    restore["name"] = restore_name
    restore["position"] = [bx + 720, cy]

    matcher["id"] = f"cmos-{key}-matcher"
    matcher["name"] = matcher_name
    matcher["position"] = [bx + 960, cy]

    nodes.extend([build, upsert, restore, matcher])

    # Preserve the existing direct ntfy path and add the central path.
    branch_conn[0].append({
        "node": build_name,
        "type": "main",
        "index": 0
    })

    connections[build_name] = {
        "main": [[{
            "node": upsert_name,
            "type": "main",
            "index": 0
        }]]
    }

    connections[upsert_name] = {
        "main": [[{
            "node": restore_name,
            "type": "main",
            "index": 0
        }]]
    }

    connections[restore_name] = {
        "main": [[{
            "node": matcher_name,
            "type": "main",
            "index": 0
        }]]
    }

    connections[matcher_name] = {"main": [[]]}

    old_version = row["activeVersionId"] or row["versionId"]
    new_version = str(uuid.uuid4())

    now = (
        datetime.now(timezone.utc)
        .isoformat(timespec="milliseconds")
        .replace("+00:00", "Z")
    )

    nodes_json = json.dumps(nodes, separators=(",", ":"))
    connections_json = json.dumps(connections, separators=(",", ":"))

    clone_history(
        cfg["workflow_id"],
        old_version,
        new_version,
        nodes_json,
        connections_json,
        now
    )

    wf_cols = {c["name"] for c in columns("workflow_entity")}

    sets = ['"nodes"=?', '"connections"=?']
    vals = [nodes_json, connections_json]

    if "versionId" in wf_cols:
        sets.append('"versionId"=?')
        vals.append(new_version)

    if "activeVersionId" in wf_cols:
        sets.append('"activeVersionId"=?')
        vals.append(new_version)

    if "versionCounter" in wf_cols:
        sets.append('"versionCounter"=COALESCE("versionCounter",0)+1')

    if "updatedAt" in wf_cols:
        sets.append('"updatedAt"=?')
        vals.append(now)

    vals.append(cfg["workflow_id"])

    cur.execute(
        f'UPDATE workflow_entity SET {",".join(sets)} WHERE id=?',
        vals
    )

    if table_exists("workflow_published_version"):
        pcols = {c["name"] for c in columns("workflow_published_version")}

        wf_col = next(
            (x for x in ("workflowId","workflow_id") if x in pcols),
            None
        )

        ver_col = next(
            (
                x for x in
                ("publishedVersionId","versionId","version_id")
                if x in pcols
            ),
            None
        )

        if wf_col and ver_col:
            cur.execute(
                f'UPDATE workflow_published_version '
                f'SET "{ver_col}"=? WHERE "{wf_col}"=?',
                (new_version, cfg["workflow_id"])
            )

    print(
        f"{key.upper()}: patched "
        f"{old_version} -> {new_version}"
    )

    return True

try:
    cur.execute("BEGIN IMMEDIATE")

    changed = False

    for key in requested:
        if patch_source(key, PROFILES[key]):
            changed = True

    con.commit()

except Exception:
    con.rollback()
    raise

finally:
    con.close()

print("CHANGED:", changed)
PY


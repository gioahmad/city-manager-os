#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${CMOS_REPO:-/opt/city-manager-os}"
cd "$REPO"

echo "=== CITY MANAGER OS PERFORMANCE AUDIT ==="
echo "Measured from inside citymanager-dashboard; application + PostgreSQL latency, not internet latency."
echo

docker exec -i citymanager-dashboard python - <<'PY'
import statistics
import time
import urllib.request

from private_auth import COOKIE_NAME,_accounts,_issue_session

account=next(a for a in _accounts().values() if a.role=='EXECUTIVE')
headers={'Cookie':COOKIE_NAME+'='+_issue_session(account)}
paths=[
    ('Dashboard','/'),
    ('Alerts 24h','/alerts?window=24h'),
    ('Mapping Center','/map'),
    ('Workspace Today','/workspace/api/state?view=today'),
    ('Workspace Intelligence','/workspace/api/state?view=intelligence&window=24h'),
    ('What Changed','/what-changed'),
    ('Source Health','/source-health'),
    ('Notification History','/deliveries'),
]
print(f"{'Route':24} {'p50 ms':>9} {'max ms':>9} {'bytes':>10}")
print('-'*58)
problems=[]
for label,path in paths:
    samples=[]
    size=0
    for attempt in range(4):
        request=urllib.request.Request('http://127.0.0.1:8000'+path,headers=headers)
        started=time.perf_counter()
        with urllib.request.urlopen(request,timeout=45) as response:
            body=response.read()
            elapsed=(time.perf_counter()-started)*1000
            assert response.status==200,(path,response.status)
            size=len(body)
            if attempt:
                samples.append(elapsed)
    p50=statistics.median(samples)
    maximum=max(samples)
    print(f"{label:24} {p50:9.1f} {maximum:9.1f} {size:10,d}")
    if p50>=1000:
        problems.append((label,p50))
print()
if problems:
    print("REVIEW:",", ".join(f"{name} p50={ms:.0f}ms" for name,ms in problems))
else:
    print("PASS: no audited core route has an internal p50 of 1 second or more.")
PY

echo
echo "=== DATABASE CONNECTIONS ==="
docker exec -i citymanager-postgis sh -lc 'psql -X -U "$POSTGRES_USER" -d "$POSTGRES_DB" -P pager=off' <<'SQL'
SELECT state,count(*) FROM pg_stat_activity
WHERE datname=current_database()
GROUP BY state ORDER BY state;
SQL

echo
echo "=== DATABASE CACHE / SIZE ==="
docker exec -i citymanager-postgis sh -lc 'psql -X -U "$POSTGRES_USER" -d "$POSTGRES_DB" -P pager=off' <<'SQL'
SELECT pg_size_pretty(pg_database_size(current_database())) AS database_size;
SELECT
  sum(blks_hit) AS cache_hits,
  sum(blks_read) AS disk_reads,
  round(100.0*sum(blks_hit)/nullif(sum(blks_hit)+sum(blks_read),0),2) AS cache_hit_pct
FROM pg_stat_database
WHERE datname=current_database();
SQL

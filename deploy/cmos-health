#!/usr/bin/env bash
set -euo pipefail

N8N_DIR=$(docker inspect n8n --format \
'{{range .Mounts}}{{if eq .Destination "/home/node/.n8n"}}{{.Source}}{{end}}{{end}}')

N8N_DB="$N8N_DIR/database.sqlite"

echo "=== CITY MANAGER OS LIVE HEALTH ==="
echo

./deploy/cmos-source status

echo
echo "=== EXECUTIVE AUTOMATION ==="

python3 - "$N8N_DB" <<'PY2'
import sqlite3, json, sys

WF_ID = "EAChiefOfStaff01"

con = sqlite3.connect(sys.argv[1])
con.row_factory = sqlite3.Row

r = con.execute(
    '''
    SELECT
      name,
      active,
      nodes,
      activeVersionId,
      versionCounter
    FROM workflow_entity
    WHERE id=?
    ''',
    (WF_ID,)
).fetchone()

if not r:
    print("EXEC_ASSISTANT missing")
else:
    nodes = json.loads(r["nodes"])

    sched = next(
        (
            n for n in nodes
            if n.get("name") == "Hourly Executive Assistant Scan"
        ),
        None
    )

    interval = "?"
    if sched:
        interval = (
            sched.get("parameters", {})
                 .get("rule", {})
                 .get("interval", [{}])[0]
                 .get("minutesInterval", "?")
        )

    published = con.execute(
        '''
        SELECT count(*)
        FROM workflow_history
        WHERE workflowId=?
          AND versionId=?
        ''',
        (WF_ID, r["activeVersionId"])
    ).fetchone()[0]

    print(
        f"EXEC_ASSISTANT "
        f"active={r['active']} "
        f"published={published} "
        f"interval={interval}m "
        f"version={r['versionCounter']}"
    )

con.close()
PY2

echo
echo "=== ROUTING / LAST ACTIVITY ==="

docker exec -i citymanager-postgis sh -lc \
'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'

\pset pager off

WITH sources(source) AS (
    VALUES
      ('PSEG'),
      ('NHRFR_DISP'),
      ('NJ_DIVERT'),
      ('EARTHQUAKE'),
      ('ORU'),
      ('BNN'),
      ('NHRFR_RADIO'),
      ('WPD_RADIO'),
      ('EXEC_ASSISTANT')
),
routes AS (
    SELECT
        UPPER(w.search_term) AS source,
        bool_or(
            w.active
            AND r.active
            AND s.active
            AND s.subscriber_id = 'GIO_CATCHALL'
        ) AS gio_route
    FROM watch_items w
    LEFT JOIN watch_item_recipients r
        ON r.watch_item_id = w.id
    LEFT JOIN subscribers s
        ON s.id = r.subscriber_id
    GROUP BY UPPER(w.search_term)
),
activity AS (
    SELECT
        a.source,
        COUNT(DISTINCT a.id) AS alerts,
        MAX(a.received_at) AS last_alert,

        COUNT(DISTINCT d.id) FILTER (
            WHERE d.status = 'SENT'
              AND ds.subscriber_id = 'GIO_CATCHALL'
        ) AS gio_sent,

        MAX(d.created_at) FILTER (
            WHERE d.status = 'SENT'
              AND ds.subscriber_id = 'GIO_CATCHALL'
        ) AS last_gio_sent,

        COUNT(DISTINCT d.id) FILTER (
            WHERE d.status = 'SENT'
        ) AS total_sent

    FROM alerts a
    LEFT JOIN deliveries d
        ON d.alert_id = a.id
    LEFT JOIN subscribers ds
        ON ds.id = d.subscriber_id
    GROUP BY a.source
)
SELECT
    x.source,
    COALESCE(r.gio_route,false) AS gio_route,
    COALESCE(a.alerts,0) AS alerts,
    COALESCE(a.gio_sent,0) AS gio_sent,
    COALESCE(a.total_sent,0) AS total_sent,
    a.last_alert,
    a.last_gio_sent
FROM sources x
LEFT JOIN routes r ON r.source = x.source
LEFT JOIN activity a ON a.source = x.source
ORDER BY x.source;

SQL

echo
docker ps --filter name=n8n --format 'n8n: {{.Status}}'

echo
echo "=== UNEXPECTED ACTIVE WORKFLOWS ==="

N8N_DIR=$(docker inspect n8n --format \
'{{range .Mounts}}{{if eq .Destination "/home/node/.n8n"}}{{.Source}}{{end}}{{end}}')

python3 - "$N8N_DIR/database.sqlite" <<'PY'
import sqlite3, json, sys

EXPECTED_RAW = {
    "waw3VpW2qWPnUK1r",
    "eRiL5XxpySpnIULD",
    "ESH9c2pZ8QfkMosO",
    "sMCW36NqcgIkFrU6",
    "tnabHwARR0DY3LVl",
}

con = sqlite3.connect(sys.argv[1])
con.row_factory = sqlite3.Row

unexpected = []

for r in con.execute("""
    SELECT id,name,nodes
    FROM workflow_entity
    WHERE active=1
    ORDER BY name
"""):
    nodes = json.loads(r["nodes"])

    central = any(
        "Central Watchlist Matcher" in n.get("name","")
        or "Build Standard" in n.get("name","")
        for n in nodes
    )

    if not central and r["id"] not in EXPECTED_RAW:
        unexpected.append((r["name"], r["id"]))

if not unexpected:
    print("NONE — all active workflows accounted for")
else:
    for name, wid in unexpected:
        print(f"CHECK: {name} [{wid}]")

con.close()
PY

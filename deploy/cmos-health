echo "=== ROUTING / LAST ACTIVITY ==="

docker exec -i citymanager-postgis sh -lc \
'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'

\pset pager off

WITH sources(source) AS (
    VALUES
      ('PSEG'),
      ('NHRFR_DISP'),
      ('NJ_DIVERT'),
      ('EARTHQUAKE'),
      ('ORU'),
      ('BNN'),
      ('NHRFR_RADIO'),
      ('WPD_RADIO'),
      ('EXEC_ASSISTANT'),
      ('NOAA_TIDE'),
      ('NWS_FLOOD')
),
routes AS (
    SELECT
        UPPER(w.search_term) AS source,
        bool_or(
            w.active
            AND r.active
            AND s.active
            AND s.subscriber_id = 'GIO_CATCHALL'
        ) AS gio_route
    FROM watch_items w
    LEFT JOIN watch_item_recipients r
        ON r.watch_item_id = w.id
    LEFT JOIN subscribers s
        ON s.id = r.subscriber_id
    GROUP BY UPPER(w.search_term)
),
activity AS (
    SELECT
        a.source,
        COUNT(DISTINCT a.id) AS alerts,
        MAX(a.received_at) AS last_alert,

        COUNT(DISTINCT d.id) FILTER (
            WHERE d.status = 'SENT'
              AND ds.subscriber_id = 'GIO_CATCHALL'
        ) AS gio_sent,

        MAX(d.created_at) FILTER (
            WHERE d.status = 'SENT'
              AND ds.subscriber_id = 'GIO_CATCHALL'
        ) AS last_gio_sent,

        COUNT(DISTINCT d.id) FILTER (
            WHERE d.status = 'SENT'
        ) AS total_sent

    FROM alerts a
    LEFT JOIN deliveries d
        ON d.alert_id = a.id
    LEFT JOIN subscribers ds
        ON ds.id = d.subscriber_id
    GROUP BY a.source
)
SELECT
    x.source,
    COALESCE(r.gio_route,false) AS gio_route,
    COALESCE(a.alerts,0) AS alerts,
    COALESCE(a.gio_sent,0) AS gio_sent,
    COALESCE(a.total_sent,0) AS total_sent,
    a.last_alert,
    a.last_gio_sent
FROM sources x
LEFT JOIN routes r ON r.source = x.source
LEFT JOIN activity a ON a.source = x.source
ORDER BY x.source;


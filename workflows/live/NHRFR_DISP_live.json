        "webhookId": "d2db1f62-a286-4a58-ac89-62700339f469"
      },
      {
        "parameters": {
          "jsCode": "for (const item of $input.all()) {\n  const preview = item.json.body?.body_preview || '';\n  \n  // 1. Extract Call Type\n  const dateMatch = preview.match(/\\d{1,2}\\/\\d{1,2}\\s+([^\\s]+)/);\n  const callType = dateMatch ? dateMatch[1] : 'Dispatch';\n  \n  // 2. Extract Town Code\n  const incidentMatch = preview.match(/([^\\s]+)\\s+INCIDENT/i);\n  const townCode = incidentMatch ? incidentMatch[1].toUpperCase() : '';\n  \n  // 3. Map abbreviation to full city name\n  const townMap = {\n    'UC': 'Union City',\n    'WNY': 'West New York',\n    'WEE': 'Weehawken',\n    'GUTT': 'Guttenberg',\n    'NB': 'North Bergen'\n  };\n  const townFull = townMap[townCode] || townCode;\n  \n  // 4. Extract Address\n  let address = '';\n  if (callType && townCode) {\n    // Matches everything between Call Type and Town Code\n    const regexString = `${callType}\\\\s+(.+?)\\\\s+${townCode}\\\\s+INCIDENT`;\n    const addressMatch = preview.match(new RegExp(regexString, 'i'));\n    if (addressMatch) {\n      address = addressMatch[1].trim();\n    }\n  }\n  \n  // 5. Construct Google Maps URL\n  let gmapsUrl = '';\n  if (address && townFull) {\n    const searchString = `${address}, ${townFull}, NJ`;\n    gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(searchString)}`;\n  }\n  \n  item.json.ntfy_title = townCode ? `${callType} - ${townCode}` : callType;\n  item.json.address = address;\n  item.json.townFull = townFull;\n  item.json.gmapsUrl = gmapsUrl;\n}\n\nreturn $input.all();"
        },
        "name": "Parse Dispatch",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
